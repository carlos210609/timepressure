NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

TIMEPRESSURE_TARGET_URL=https://example.com
TIMEPRESSURE_TICK_MS=10000
TIMEPRESSURE_CYCLE_MS=3600000
TIMEPRESSURE_PRESSURE_MULTIPLIER=1.5
TIMEPRESSURE_ALLOW_NETWORK=true
TIMEPRESSURE_DATA_DIR=.data

TIMEPRESSURE_BROWSER_ENABLED=false
TIMEPRESSURE_BROWSER_HEADLESS=true
TIMEPRESSURE_BROWSER_ALLOWED_DOMAINS=
