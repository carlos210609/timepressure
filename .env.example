# TimePressure
TIMEPRESSURE_TARGET_CENTS=1
TIMEPRESSURE_CYCLE_MS=3600000
TIMEPRESSURE_TICK_MS=10000
TIMEPRESSURE_DATA_DIR=.data
TIMEPRESSURE_ALLOW_NETWORK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TIMEPRESSURE_MODEL=gpt-5.6

# Litecoin Core JSON-RPC
# Mainnet default RPC port is 9332.
LTC_RPC_URL=http://127.0.0.1:9332/
LTC_RPC_USER=
LTC_RPC_PASSWORD=
LTC_PAYOUT_ADDRESS=
LTC_MIN_PAYOUT=0.001
LTC_AUTO_PAYOUT=false
