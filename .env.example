TIMEPRESSURE_TARGET_CENTS=10
TIMEPRESSURE_CYCLE_MS=3600000
TIMEPRESSURE_TICK_MS=10000
# Nonlinear urgency multiplier: 1.0 = normal, 1.5 = strong (default), max 3.0
TIMEPRESSURE_PRESSURE_MULTIPLIER=1.5
# Consecutive low-activity ticks before the agent should re-plan aggressively
TIMEPRESSURE_IDLE_TICK_THRESHOLD=3
TIMEPRESSURE_DATA_DIR=.data
TIMEPRESSURE_ALLOW_NETWORK=true
TIMEPRESSURE_BROWSER_ENABLED=true
TIMEPRESSURE_BROWSER_HEADLESS=true
# Comma-separated domains. Required before browser automation.
TIMEPRESSURE_BROWSER_ALLOWED_DOMAINS=example.com
TIMEPRESSURE_AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
LTC_RPC_URL=http://127.0.0.1:9332/
LTC_RPC_USER=
LTC_RPC_PASSWORD=
LTC_PAYOUT_ADDRESS=
LTC_MIN_PAYOUT=0.001
LTC_AUTO_PAYOUT=false
LTC_USD_RATE=

# Disabled by default. Enable only if you explicitly trust local shell execution.
TIMEPRESSURE_SHELL_ENABLED=false

# Controlled temporary email (disabled by default; target domains must be explicit)
TIMEPRESSURE_TEMP_EMAIL_ENABLED=false
TIMEPRESSURE_TEMP_EMAIL_PROVIDER_URL=https://temp-mail.io/en
TIMEPRESSURE_TEMP_EMAIL_TARGET_DOMAINS=


# OKX.AI Task Marketplace — the only marketplace integration.
TIMEPRESSURE_OKX_AI_URL=https://okx.ai
TIMEPRESSURE_OKX_AI_TASK_HALL_URL=https://okx.ai
# Optional: official Onchain OS / OKX.AI bridge command.
TIMEPRESSURE_OKX_AI_BRIDGE=
# Optional selector for the read-only public task-hall fallback.
TIMEPRESSURE_OKX_AI_TASK_SELECTOR=a[href*='task'],a[href*='Task'],a[href*='tasks']
TIMEPRESSURE_MARKETPLACE_AUTOMATION=false
TIMEPRESSURE_MARKETPLACE_ELIGIBLE=false


# Marketplace selector: exactly one is active at a time.
TIMEPRESSURE_MARKETPLACE_STATE_FILE=.data/marketplace.json
# Optional bridge commands for non-OKX connectors. Keep secrets out of Git.
TIMEPRESSURE_0XWORK_BRIDGE=
TIMEPRESSURE_UPWORK_BRIDGE=
TIMEPRESSURE_FIVERR_BRIDGE=
TIMEPRESSURE_FREELANCER_BRIDGE=
TIMEPRESSURE_CLICKWORKER_BRIDGE=
TIMEPRESSURE_TOLOKA_BRIDGE=
TIMEPRESSURE_AGENTHANSA_BRIDGE=
TIMEPRESSURE_CLUSTLY_BRIDGE=
TIMEPRESSURE_DAYDREAMS_BRIDGE=
TIMEPRESSURE_AGENTPACT_BRIDGE=
TIMEPRESSURE_BOUNTYBOOK_BRIDGE=
TIMEPRESSURE_WURK_BRIDGE=


# Financial control plane — PAPER by default. LIVE requires explicit operator action.
TIMEPRESSURE_COINBASE_PRODUCTS=BTC-USD
TIMEPRESSURE_KRAKEN_SYMBOLS=BTC/USD
TIMEPRESSURE_BUGCROWD_TOKEN=
